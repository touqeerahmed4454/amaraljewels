            "custom_liquid_37WVkA": {
              "type": "custom-liquid",
              "name": "t:names.custom_liquid",
              "settings": {
                "custom_liquid": "<div class=\"delivery-timer-wrapper\">\n  Order in the next <span id=\"countdown-timer\" class=\"timer-highlight\">--h --m</span>, \n  get it by <span id=\"delivery-day-date\" class=\"date-highlight\">--day, --date</span>.\n</div>\n<script>\nfunction updateDeliveryInfo() {\n    const now = new Date();\n    \n    // 1. Countdown Logic (2:00 PM Cut-off)\n    let targetTime = new Date();\n    targetTime.setHours(14, 0, 0, 0); \n\n    if (now > targetTime) {\n        targetTime.setDate(now.getDate() + 1);\n    }\n\n    const diff = targetTime - now;\n    const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);\n    const minutes = Math.floor((diff / (1000 * 60)) % 60);\n\n    // Timer display update\n    document.getElementById('countdown-timer').innerText = hours + \"h \" + minutes + \"m\";\n\n    // 2. Delivery Date Logic (4 Days gap)\n    let deliveryDate = new Date();\n    let daysToAdd = 4;\n\n    if (now.getHours() >= 14) {\n        daysToAdd = 5;\n    }\n    \n    deliveryDate.setDate(now.getDate() + daysToAdd);\n\n    // Date formatting\n    const options = { weekday: 'long', day: 'numeric', month: 'long' };\n    const formattedDate = deliveryDate.toLocaleDateString('en-AU', options);\n    \n    document.getElementById('delivery-day-date').innerText = formattedDate;\n}\n\n// Har minute update karne ke liye\nsetInterval(updateDeliveryInfo, 60000);\nupdateDeliveryInfo();\n</script>"
              },
              "blocks": {}
            },
