            "custom_liquid_hEeVJQ": {
              "type": "custom-liquid",
              "name": "t:names.custom_liquid",
              "settings": {
                "custom_liquid": "<div class=\"shipping-info-box\" style=\"background: #fff8f0; padding: 15px; border-radius: 4px; display: flex; align-items: flex-start; gap: 10px;\">\n  <span style=\"color: #9d7a54; font-size: 20px;\">🕒</span>\n  \n  <div>\n    <strong style=\"display: block; margin-bottom: 4px;\">Made to order. Ships in 2-3 weeks.</strong>\n    <p id=\"dynamic-shipping-text\" style=\"margin: 0; color: #444;\">\n      Ready to ship. Order before 2pm AEST today, get it by <span id=\"delivery-date\">...</span>.\n    </p>\n  </div>\n</div>\n\n<script>\n  function getShippingDate() {\n    const now = new Date();\n    \n    // AEST Timezone adjust karne ke liye (Optional, default browser time use karega)\n    const currentHour = now.getHours();\n    \n    let deliveryDate = new Date();\n    \n    // Agar dopahar ke 2 baje (14:00) ke baad order ho raha hai, toh 1 din mazeed add karein\n    let daysToAdd = 4;\n    if (currentHour >= 14) {\n      daysToAdd = 5;\n    }\n    \n    deliveryDate.setDate(now.getDate() + daysToAdd);\n\n    // Date formatting (e.g., Friday 9 May)\n    const options = { weekday: 'long', day: 'numeric', month: 'long' };\n    const formattedDate = deliveryDate.toLocaleDateString('en-AU', options);\n\n    document.getElementById('delivery-date').innerText = formattedDate;\n  }\n\n  // Function Run karein\n  getShippingDate();\n</script>"
              },
              "blocks": {}
            },
