{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    background-color: {{ section.settings.bg_color }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .features-grid__header {
    text-align: center;
    max-width: 520px;
    margin: 0 auto 40px auto;
    padding: 0 20px;
  }

  .features-grid__title {
    margin-bottom: 10px;
    color: #121212;
color: #181818;
text-align: center;
    font-family: var(--font-h4--family);
font-size: 50px;
font-style: normal;
font-weight: 500;
line-height: normal;
  }

  .features-grid__subtext {
    color: #181818;
text-align: center;
    font-family: var(--font-paragraph--family);
font-size: 18px;
font-style: normal;
font-weight: 400;
line-height: 28px; /* 155.556% */
  }

  .features-grid__container {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 0 4rem;
    max-width: 100%;
    margin: 0 auto;
  }

  .feature-card {
    border: 1px solid #EADFCE;
    padding: 20px 25px 20px 20px;
    border-radius: 5px;
    background: #fff;
    display: flex;
    flex-direction: column;
  }

  .feature-card__header {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 15px;
  }

  .feature-card__icon {
    width: 40px;
    height: 40px;
    object-fit: contain;
  }

  .feature-card__heading {
    margin: 0;
color: #181818;
 font-family: var(--font-h4--family);
font-size: 24px;
font-style: normal;
font-weight: 500;
line-height: normal;

  }

  .feature-card__description {
    margin: 0;

    color: #353535;
    font-family: var(--font-paragraph--family);
font-size: 18px;
font-style: normal;
font-weight: 400;
line-height: 28px; /* 155.556% */
  }

  .features-grid__footer {
    text-align: center;
    margin-top: 40px;
    padding: 30px 20px;
    border-top: 1px solid #EADFCE;
    width: 91%;
    margin:50px auto 0 auto;

    color: #353535;
  font-family: var(--font-paragraph--family);
font-size: 16px;
font-style: normal;
font-weight: 700;
line-height: 25px; /* 156.25% */
  }

  /* Desktop Styles (image_62abdc.png) */
  @media screen and (min-width: 750px) {
    .features-grid__container {
      flex-direction: row;
      justify-content: center;
    }
    
    .feature-card {
      flex: 1;
    }
    
    .features-grid__title {
      font-size: 48px;
    }
  }
{%- endstyle -%}

<div class=" section-{{ section.id }}-padding">
  <div class="features-grid__header">
    <h2 class="features-grid__title">{{ section.settings.title }}</h2>
    <div class="features-grid__subtext">{{ section.settings.subtext }}</div>
  </div>

  <div class="features-grid__container">
    {%- for block in section.blocks -%}
      <div class="feature-card" {{ block.shopify_attributes }}>
        <div class="feature-card__header">
          {%- if block.settings.icon != blank -%}
            <img src="{{ block.settings.icon | image_url: width: 100 }}" class="feature-card__icon" alt="{{ block.settings.heading }}" loading="lazy">
          {%- endif -%}
          <h3 class="feature-card__heading">{{ block.settings.heading }}</h3>
        </div>
        <p class="feature-card__description">{{ block.settings.description }}</p>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.settings.footer_text != blank -%}
    <div class="features-grid__footer">
      {{ section.settings.footer_text }}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Features Grid",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Why solid gold"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subheading Text",
      "default": "There's a reason we don't plate. Plated jewellery flakes. Solid gold doesn't."
    },
    {
      "type": "textarea",
      "id": "footer_text",
      "label": "Footer Comparison Text",
      "default": "Plated jewellery: $40-80, replaced every 12-18 months. A solid 18k Amaral piece: bought once."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Feature Heading",
          "default": "Lasts decades"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Solid 18k won't fade, flake, or turn your skin green."
        },
   ]
    }
  ],
  "presets": [
    {
      "name": "Features Grid",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}