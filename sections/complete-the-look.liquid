<style>
  .bundle-wrapper {
    padding: 60px 3%;
    width: 100%;
  }
  .bundle-container {
    display: flex;
    gap:100px;
    align-items: center;
    max-width: 100%;
    margin: 0 auto;
  }
  .bundle-main-image {
    flex: 1;
    position: relative;
    line-height: 0;
  }
  .bundle-main-image img {
    width: 100%;
    height: auto;
    object-fit: cover;
  }
  .image-overlay-badge {
    position: absolute;
    bottom: 20px;
    right: 20px;
    background: #a37e52; /* Gold/Brown color */
    color: white;
    padding: 15px 25px;
    text-align: left;
  }
  .image-overlay-badge h3 {
    margin: 0; font-size: 20px; 
  }
  .image-overlay-badge p {
    margin: 0; font-size: 12px; letter-spacing: 1px;
  }
  .bundle-content {
    flex: 1;
  }
  .sub-heading {
    color: #A47944;  font-family: var(--font-paragraph--family);
font-weight: 600;

font-size: 14px;

line-height: 18px;
letter-spacing: 0px;
vertical-align: middle;
text-transform: uppercase;
letter-spacing: 1px;
  }
  .main-heading {
font-family: var(--font-h4--family);
font-weight: 500;
font-size: 50px;
line-height: 100%;
padding-top:20px;
letter-spacing: 0%;
 margin: 10px 0;
  }
  .description {
font-family: var(--font-paragraph--family);
font-weight: 400;
font-size: 18px;
line-height: 28px;
letter-spacing: 0px;
vertical-align: middle;
 margin-bottom: 30px;
  }
  .bundle-product-item {
    display: flex;
    gap: 20px;
    align-items: center;
    margin-bottom: 20px;
    padding-bottom: 20px;
  }
  .product-thumb {
    width: 80px; height: 80px; background: #f9f9f9;
  }
  .product-thumb img {
    width: 100%; height: 100%; object-fit: contain;
  }
  .product-info h4 {
    margin: 0; font-family: var(--font-paragraph--family);
font-weight: 700;
font-style: Bold;
font-size: 16px;
line-height: 24px;
letter-spacing: 0px;
vertical-align: middle;
 color: #1a1a1a;
  }
  .product-info p {
    margin: 5px 0;font-family: var(--font-paragraph--family);
font-weight: 400;
font-size: 14px;
line-height: 20px;
letter-spacing: 0px;
vertical-align: middle;

  }
  .add-bundle-btn {
font-family: var(--font-paragraph--family);
font-weight: 400;
font-size: 10px;
line-height: 15px;
letter-spacing: 0px;
text-align: center;
vertical-align: middle;
 text-decoration: underline; color: #1a1a1a; letter-spacing: 0.5px;
  }
.bundle-main-image.website-res{
display:none;
  }
  /* MOBILE DESIGN */
  @media (max-width: 767px) {
    .bundle-container {
      flex-direction: column;
    }
    .bundle-content {
      order: 1; /* Content pehle */
      text-align: left;
    }
    .bundle-main-image {
      order: 2; /* Image beech mein */
      width: 100%;
    }
    .product-list {
      order: 3; /* Products image ke niche */
      margin-top: 30px;
    }
    .main-heading {
      font-size: 36px;
      padding-top: 5px;
      margin-bottom:0px;
    }
    .bundle-main-image.website{
    display:none;
  }
  .bundle-main-image.website-res{
display:block;
  }
  .bundle-wrapper {
    padding: 35px 3% 0px;
  }
  .description{
  font-size: 16px;}
  }
</style>
<div class="bundle-section-{{ section.id }} bundle-wrapper" style="background-color: {{ section.settings.bg_color }};">
  <div class="bundle-container">
    
    <div class="bundle-main-image website">
      {% if section.settings.main_image != blank %}
        <img src="{{ section.settings.main_image | img_url: '1000x' }}" alt="Curated by Amaral">
        <div class="image-overlay-badge">
          <h3>{{ section.settings.badge_title }}</h3>
          <p>{{ section.settings.badge_year }}</p>
        </div>
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
      {% endif %}
    </div>

    <div class="bundle-content">
      <span class="sub-heading">{{ section.settings.sub_title }}</span>
      <h2 class="main-heading">{{ section.settings.title }}</h2>
      <p class="description">{{ section.settings.description }}</p>

       <div class="bundle-main-image website-res">
      {% if section.settings.main_image != blank %}
        <img src="{{ section.settings.main_image | img_url: '1000x' }}" alt="Curated by Amaral">
        <div class="image-overlay-badge">
          <h3>{{ section.settings.badge_title }}</h3>
          <p>{{ section.settings.badge_year }}</p>
        </div>
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
      {% endif %}
    </div>

      <div class="product-list">
        {% for block in section.blocks %}
          {% assign product = all_products[block.settings.product_item] %}
          <div class="bundle-product-item">
            <div class="product-thumb">
              {% if product != blank %}
                <img src="{{ product.featured_image | img_url: '150x' }}" alt="{{ product.title }}">
              {% else %}
                {{ 'product-1' | placeholder_svg_tag }}
              {% endif %}
            </div>
            <div class="product-info">
              <h4>{{ product.title | default: "The Essential Studs" }}</h4>
              <p>{{ block.settings.pairing_text }}</p>
              <a href="{{ product.url }}" class="add-bundle-btn">ADD TO BUNDLE +</a>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Complete the Look Bundle",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main Showcase Image"
    },
    {
      "type": "text",
      "id": "badge_title",
      "label": "Badge Title",
      "default": "Curated by Amaral"
    },
    {
      "type": "text",
      "id": "badge_year",
      "label": "Badge Subtext",
      "default": "SINCE 1981"
    },
    {
      "type": "text",
      "id": "sub_title",
      "label": "Sub-heading",
      "default": "STYLING GUIDE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Complete the Look"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Our designers have curated the perfect pairings for your signature gold pieces."
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Bundle Product",
      "settings": [
        {
          "type": "product",
          "id": "product_item",
          "label": "Select Product"
        },
        {
          "type": "text",
          "id": "pairing_text",
          "label": "Pairing Text",
          "default": "Pairs perfectly with: The Heirloom Chain"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Complete the Look Bundle",
      "blocks": [
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}