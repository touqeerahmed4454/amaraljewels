{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
  }

  .gold-compare__header {
    text-align: center;
    margin-bottom: 40px;
    padding: 0 20px;
  }

  .gold-compare__title {
    margin-bottom: 10px;
    color: #181818;
text-align: center;
 font-family: var(--font-h4--family);
font-size: 50px;
font-style: normal;
font-weight: 500;
line-height: normal;
  }
  .gold-compare__header p{
    color: #181818;
text-align: center;
  font-family: var(--font-paragraph--family);
font-size: 18px;
font-style: normal;
font-weight: 400;
line-height: 28px; /* 155.556% */
}
  .gold-compare__grid {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 100%;
    margin: 0 auto;
    padding: 0 2.8rem;
  }

  .gold-card {
    border: 1px solid #EADFCE;
    padding: 30px;
    border-radius: 5px;
    background: #fff;
    text-align: left;
  }
 .gold-card
  .gold-card:nth-child(2) {
     background: #FFFDFA;
       border: 1px solid #EADFCE;
  }
  .gold-card__title {
    margin: 0;
    color: #181818;
 font-family: var(--font-h4--family);
font-size: 36px;
font-style: normal;
font-weight: 500;
line-height: normal;
  }

  .gold-card__weight {
    margin-bottom: 20px;
    display: block;
    color: #A47944;
  font-family: var(--font-paragraph--family);
font-size: 12px;
font-style: normal;
font-weight: 400;
line-height: 20px; /* 166.667% */
  }

  .gold-card__label {
    text-transform:capitalize;
    margin-bottom: 5px;
    display: block;
    color: #353535;
  font-family: var(--font-paragraph--family);
font-size: 12px;
font-style: normal;
font-weight: 400;
line-height: 17px; /* 141.667% */
  }

  .gold-card__info {
    margin-bottom: 30px;
    margin-top:0px;

    color: #181818;
  font-family: var(--font-paragraph--family);
font-size: 16px;
font-style: normal;
font-weight: 400;
line-height: 22px; /* 137.5% */
  }

  .gold-card__footer {
    border-top: 1px solid #EADFCE;
    padding-top: 20px;
    margin-top: auto;
  }

    .gold-card__footer .gold-card__label{
    color: #A47944;
  font-family: var(--font-paragraph--family);
font-size: 12px;
font-style: normal;
text-transform: capitalize;
font-weight: 400;
line-height: 20px; /* 166.667% */
  }

  .gold-card__price {
    color: #181818;
 font-family: var(--font-h4--family);
font-size: 22px;
font-style: normal;
font-weight: 500;
line-height: normal;
  }

  .gold-compare__btn-wrapper {
    text-align: center;
    margin-top: 40px;
  }

  .gold-compare__button {
    display: inline-block;
    padding: 15px 40px;
    background-color: #A47944;
    text-decoration: none;
    border-radius: 5px;
    color: #FFF;
text-align: center;
  font-family: var(--font-paragraph--family);
font-size: 16px;
font-style: normal;
font-weight: 600;
line-height: 24px; /* 150% */
letter-spacing: 1.6px;
text-transform: uppercase;
  }

  @media screen and (min-width: 750px) {
    .gold-compare__grid {
      flex-direction: row;
    }
    .gold-card {
      flex: 1;
    }
    .gold-compare__title {
      font-size: 48px;
    }
  }

  @media (max-width: 767px) {
    .gold-compare__header {
    text-align: center;
    margin-bottom:25px;
    padding: 0 15px;
}
.gold-compare__title {
    margin-bottom: 10px;
    font-size: 40px;
    letter-spacing: 0px;
 }
 .gold-compare__header p{
  font-size: 16px;
 }
 .gold-compare__header p br{
  display:none;
 }
 .gold-compare__grid {
    padding: 0 1rem;
}
.gold-compare__button {
    padding: 20px 40px;
  }
    .section-{{ section.id }}-padding {
    padding-bottom: 40px;

  }

}


{%- endstyle -%}

<div class="section-{{ section.id }}-padding {{ section.settings.custom_class }}">
  <div class="gold-compare__header">
    <h2 class="gold-compare__title">{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subheading }}</p>
  </div>

  <div class="gold-compare__grid">
    {%- for block in section.blocks -%}
      <div class="gold-card" {{ block.shopify_attributes }}>
        <h3 class="gold-card__title">{{ block.settings.purity_title }}</h3>
        <span class="gold-card__weight">{{ block.settings.weight_info }}</span>

        <span class="gold-card__label">Best for</span>
        <p class="gold-card__info">{{ block.settings.best_for }}</p>

        <span class="gold-card__label">Why</span>
        <p class="gold-card__info">{{ block.settings.why_text }}</p>

        <div class="gold-card__footer">
          <span class="gold-card__label">Starting from</span>
          <div class="gold-card__price">{{ block.settings.price }}</div>
        </div>
      </div>
    {%- endfor -%}
  </div>

  {% if section.settings.button_label != blank %}
    <div class="gold-compare__btn-wrapper">
      <a href="{{ section.settings.button_link }}" class="gold-compare__button">
        {{ section.settings.button_label }}
      </a>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Gold Comparison Grid",
  "settings": [
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom Class"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Choosing your gold"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "We make every piece in three purities. Here's how to pick the one that fits."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "SHOP BY GOLD PURITY"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "purity_card",
      "name": "Purity Card",
      "settings": [
        { "type": "text", "id": "purity_title", "label": "Purity (e.g. 9ct Gold)", "default": "9ct Gold" },
        { "type": "text", "id": "weight_info", "label": "Weight Info", "default": "37.5% gold by weight." },
        { "type": "textarea", "id": "best_for", "label": "Best For", "default": "Everyday pieces and entry-priced gifts." },
        { "type": "textarea", "id": "why_text", "label": "Why Text", "default": "Hardest of the three, scratch-resistant, and the most affordable way into solid gold." },
        { "type": "text", "id": "price", "label": "Price", "default": "$390" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gold Comparison Grid",
      "blocks": [
        { "type": "purity_card" },
        { "type": "purity_card" },
        { "type": "purity_card" }
      ]
    }
  ]
}
{% endschema %}