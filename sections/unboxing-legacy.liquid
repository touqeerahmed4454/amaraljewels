<style>
  .unboxing-wrapper {
    padding: 80px 3rem;
    text-align: center;
  }
  .unboxing-container {
    max-width: 100%;
    margin: 0 auto;
  }
  .gift-icon-wrapper {
    margin-bottom: 20px;
    color: #a37e52; /* Gold color */
  }
  .gift-icon-wrapper svg {
    width: 40px; height: auto;
    margin:auto;
  }
  .unboxing-title {
font-family: var(--font-h4--family);
font-weight: 500;
font-style: Medium;
font-size: 50px;
line-height: 100%;
letter-spacing: 0%;
text-align: center;

    margin: 0 0 15px;
    color: #1a1a1a;
  }
  .unboxing-description {
    max-width: 650px;
    margin: 0 auto 0px;
padding-bottom:50px;
  font-family: var(--font-paragraph--family);
font-weight: 400;
font-size: 18px;
line-height: 30px;
letter-spacing: 0px;
text-align: center;
vertical-align: middle;

  }
  .unboxing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }
  .unboxing-card {
    border: 1px solid #f2f2f2; /* Light border around card */
    padding: 30px 15px;
    background: #fff;
  }
  .card-label {
    display: block;
  font-family: var(--font-paragraph--family);
font-weight: 600;
color:#A47944;
font-size: 12px;
line-height: 16.8px;
letter-spacing: 1.8px;
text-align: center;
vertical-align: middle;

    margin-bottom: 25px;
    text-transform: uppercase;
  }
  .card-image-wrapper img {
    width: 100%;
    height: auto;
    border-radius: 8px; /* Rounded corners */
  }

  /* MOBILE DESIGN */
  @media (max-width: 767px) {
    .unboxing-wrapper {
      padding: 50px 15px;
    }
    .unboxing-title {
      font-size: 36px;
    }
    .unboxing-description{
    font-size: 16px;
    padding-bottom:25px;
  }
    .unboxing-grid {
      grid-template-columns: 1fr; /* Stacked layout */
      gap: 20px;
    }
    .unboxing-card {
      padding: 20px 10px;
    }
    .card-label{
    padding-top: 10px;
  }
  }
</style>
<div class="unboxing-section-{{ section.id }} unboxing-wrapper" style="background-color: {{ section.settings.bg_color }};">
  <div class="unboxing-container">
    
    <div class="unboxing-header">
      <div class="gift-icon-wrapper">
       <svg width="34" height="36" viewBox="0 0 34 36" fill="none" xmlns="http://www.w3.org/2000/svg">
