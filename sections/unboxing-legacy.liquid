</svg>
 </div>
      <h2 class="unboxing-title">{{ section.settings.heading }}</h2>
      <p class="unboxing-description">{{ section.settings.subtext }}</p>
    </div>

    <div class="unboxing-grid">
      {% for block in section.blocks %}
        <div class="unboxing-card">
          <span class="card-label">{{ block.settings.label }}</span>
          <div class="card-image-wrapper">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | img_url: '600x' }}" alt="{{ block.settings.label }}">
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Unboxing the Legacy",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Unboxing the Legacy"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Every order arrives in our signature champagne-toned velvet box, accompanied by a certificate of gold authenticity and a luxury polishing cloth."
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Feature Card",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Card Label",
          "default": "SIGNATURE BOX"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Unboxing the Legacy",
      "blocks": [
        { "type": "card", "settings": { "label": "SIGNATURE BOX" } },
        { "type": "card", "settings": { "label": "CERTIFIED AUTHENTIC" } },
        { "type": "card", "settings": { "label": "GIFT MESSAGING" } }
      ]
    }
  ]
}
{% endschema %}