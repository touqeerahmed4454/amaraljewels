{% comment %}
  Custom Footer Section
{% endcomment %}

<footer class="custom-footer">
  <div class="page-width">
    <div class="custom-footer__wrapper">

      <!-- Left -->
      <div class="custom-footer__left">
        {% if section.settings.logo != blank %}
          <div class="footer-logo">
            <img
              src="{{ section.settings.logo | image_url }}"
              alt="{{ shop.name }}"
              loading="lazy"
              width="180"
              height="80"
            >
          </div>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="footer-text">
            {{ section.settings.text }}
          </div>
        {% endif %}

        <div class="footer-social">
          {% if section.settings.facebook != blank %}
            <a href="{{ section.settings.facebook }}" target="_blank">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24">
                <path fill="currentColor" d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.5-3.88 3.78-3.88 1.1 0 2.24.2 2.24.2v2.45h-1.26c-1.24 0-1.62.77-1.62 1.56V12h2.76l-.44 2.89h-2.32v6.99A10 10 0 0 0 22 12Z"/>
              </svg>
            </a>
          {% endif %}

          {% if section.settings.instagram != blank %}
            <a href="{{ section.settings.instagram }}" target="_blank">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24">
                <path fill="currentColor" d="M7 2C4.24 2 2 4.24 2 7v10c0 2.76 2.24 5 5 5h10c2.76 0 5-2.24 5-5V7c0-2.76-2.24-5-5-5H7Zm0 2h10c1.65 0 3 1.35 3 3v10c0 1.65-1.35 3-3 3H7c-1.65 0-3-1.35-3-3V7c0-1.65 1.35-3 3-3Zm11.5 1a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3ZM12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0 2a3 3 0 1 1 0 6 3 3 0 0 1 0-6Z"/>
              </svg>
            </a>
          {% endif %}
        </div>
      </div>

      <!-- Menus -->
      <div class="custom-footer__menus">

        <!-- Quick Links -->
        <div class="footer-menu-item">
          <div class="footer-title mobile-toggle">
            {{ section.settings.quick_title }}
            <span class="footer-arrow"><svg width="15" height="9" viewBox="0 0 15 9" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M0.353516 0.353516L7.35352 7.35352L14.3535 0.353516" stroke="white"/>
</svg>
</span>
          </div>

          <ul class="footer-links">
            {% for link in linklists[section.settings.quick_menu].links %}
              <li>
                <a href="{{ link.url }}">{{ link.title }}</a>
              </li>
            {% endfor %}
          </ul>
        </div>

        <!-- Policies -->
        <div class="footer-menu-item">
          <div class="footer-title mobile-toggle">
            {{ section.settings.policy_title }}
            <span class="footer-arrow"><svg width="15" height="9" viewBox="0 0 15 9" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M0.353516 0.353516L7.35352 7.35352L14.3535 0.353516" stroke="white"/>
</svg>
</span>
          </div>

          <ul class="footer-links">
            {% for link in linklists[section.settings.policy_menu].links %}
              <li>
                <a href="{{ link.url }}">{{ link.title }}</a>
              </li>
            {% endfor %}
          </ul>
        </div>

        <!-- Contact -->
        <div class="footer-menu-item">
          <div class="footer-title mobile-toggle">
            {{ section.settings.contact_title }}
            <span class="footer-arrow"><svg width="15" height="9" viewBox="0 0 15 9" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M0.353516 0.353516L7.35352 7.35352L14.3535 0.353516" stroke="white"/>
</svg>
</span>
          </div>

          <ul class="footer-links contact-list">
            {% if section.settings.phone != blank %}
              <li>
                <a href="tel:{{ section.settings.phone }}">
                  {{ section.settings.phone }}
                </a>
              </li>
            {% endif %}

            {% if section.settings.email != blank %}
              <li>
                <a href="mailto:{{ section.settings.email }}">
                  {{ section.settings.email }}
                </a>
              </li>
            {% endif %}
          </ul>
        </div>

      </div>
    </div>

    <!-- Bottom -->
    <div class="custom-footer__bottom">

      <div class="footer-copy">
        {{ section.settings.copyright }}
      </div>

      <div class="footer-payments">
        {% for type in shop.enabled_payment_types %}
          {{ type | payment_type_svg_tag }}
        {% endfor %}
      </div>

    </div>
  </div>
</footer>

<style>
.custom-footer{
  background:#000;
  color:#fff;
  padding:110px 0 20px;
}

.custom-footer *{
  box-sizing:border-box;
}

.custom-footer .page-width{
  max-width:100%;
  margin:0 auto;
  padding:0 3rem;
}

.custom-footer__wrapper{
  display:flex;
  justify-content:space-between;
  gap:60px;
  padding-bottom:40px;
}

.custom-footer__left{
  max-width:40%;
  width:100%;}

.footer-logo img{
  max-width:120px;
  width:100%;
  display:block;
}

.footer-text{
color: #FFF;
font-family: var(--font-paragraph--family);
font-size: 18px;
margin-top: 20px;
font-style: normal;
font-weight: 600;
line-height: normal;
}

.footer-social{
  display:flex;
  gap:14px;
  margin-top:20px;
}

.footer-social a{
  width:34px;
  height:34px;
  border:1px solid rgba(255,255,255,.2);
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  color:#fff;
  transition:.3s;
}

.footer-social a:hover{
  background:#fff;
  color:#000;
}

.custom-footer__menus{
  display:flex;
  justify-content:space-between;
  gap:80px;
  flex:1;
}

.footer-title{
margin-bottom:18px;
color: #FFF;
font-family: var(--font-paragraph--family);
font-size: 18px;
margin-top: 20px;
font-style: normal;
font-weight: 600;
line-height: normal;
}

.footer-links{
  list-style:none;
  padding:0;
  margin:0;
}

.footer-links li{
  margin-bottom:12px;
}

.footer-links a{
  text-decoration:none;
color: #FFF;
font-family: var(--font-paragraph--family);
font-size: 16px;
font-style: normal;
font-weight: 400;
line-height: normal;
  transition:.3s;
}

.footer-links a:hover{
  color:#fff;
}

.custom-footer__bottom{
  border-top:1px solid #fff;
  padding-top:20px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:20px;
  flex-wrap:wrap;
}

.footer-copy{
color: #FFF;
font-family: var(--font-paragraph--family);
font-size: 18px;
font-style: normal;
font-weight: 300;
line-height: normal;
}

.footer-payments{
  display:flex;
  flex-wrap:wrap;
  gap:8px;
  align-items:center;
}

.footer-payments svg{
  width:42px;
  height:auto;
}

.footer-arrow{
  display:none;
}

@media screen and (max-width:768px){
.footer-title {
    margin-top: 0px;
    padding: 15px 0px;
}

  .custom-footer__left {
    max-width: 100%;
    width: 100%;
}
  .custom-footer{
    padding:130px 0 20px;
  }
  .shopify-section-group-footer-group.section-wrapper{
      margin:0px auto -91px;
  }

  .custom-footer .page-width{
    padding:0 20px;
  }

  .custom-footer__wrapper{
    flex-direction:column;
    gap:20px;
  }
.custom-footer__bottom {
    border-top: 0px solid #fff;
    padding-top: 0px;
  }
  .custom-footer__menus{
    flex-direction:column;
    gap:0;
  }

  .footer-menu-item{
    border-top:1px solid rgba(255,255,255,.15);
    padding:14px 0;
  }

  .footer-menu-item:last-child{
    border-bottom:1px solid rgba(255,255,255,.15);
  }

  .mobile-toggle{
    display:flex;
    justify-content:space-between;
    align-items:center;
    cursor:pointer;
    margin-bottom:0;
  }

  .footer-arrow{
    display:block;
    font-size:20px;
    line-height:1;
  }

  .footer-links{
    display:none;
    padding-top:15px;
  }

  .footer-menu-item.active .footer-links{
    display:block;
  }

  .footer-menu-item.active .footer-arrow{
    transform:rotate(180deg);
  }

  .custom-footer__bottom{
    flex-direction:column;
    align-items:flex-start;
    gap:18px;
  }

  .footer-payments{
    gap:6px;
  }

  .footer-payments svg{
    width:38px;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {

  if (window.innerWidth <= 768) {

    const accordionItems = document.querySelectorAll('.footer-menu-item');

    accordionItems.forEach(function(item){

      const button = item.querySelector('.mobile-toggle');
      const content = item.querySelector('.footer-links');

      if(button && content){

        content.style.display = 'none';

        button.addEventListener('click', function(e){

          e.preventDefault();

          item.classList.toggle('active');

          if(item.classList.contains('active')){
            content.style.display = 'block';
          } else {
            content.style.display = 'none';
          }

        });

      }

    });

  }

});
</script>
{% schema %}
{
  "name": "Custom Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>More than jewellery, Amaral creates golden memories to last a lifetime.</p>"
    },

    {
      "type": "text",
      "id": "quick_title",
      "label": "Quick Links Title",
      "default": "Quick Links"
    },
    {
      "type": "link_list",
      "id": "quick_menu",
      "label": "Quick Links Menu"
    },

    {
      "type": "text",
      "id": "policy_title",
      "label": "Policies Title",
      "default": "Policies"
    },
    {
      "type": "link_list",
      "id": "policy_menu",
      "label": "Policies Menu"
    },

    {
      "type": "text",
      "id": "contact_title",
      "label": "Contact Title",
      "default": "Contact Us"
    },

    {
      "type": "text",
      "id": "phone",
      "label": "Phone Number",
      "default": "+1 866-986-7385"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "info@amaraljewels.com"
    },

    {
      "type": "url",
      "id": "facebook",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "instagram",
      "label": "Instagram URL"
    },

    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright Text",
      "default": "© 2026, Amaral Jewels Powered by Dash Optimiza"
    }
  ],
  "presets": [
    {
      "name": "Custom Footer"
    }
  ]
}
{% endschema %}