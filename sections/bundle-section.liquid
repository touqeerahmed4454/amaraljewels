<style>
  /* Common Styles */
  .bundle-main-container {
    max-width: 100%;
    margin:70px auto 0px;
    padding: 80px 7rem;
    display: flex;
    align-items: center;
    gap: 40px;
    background:#FAFAFA;
  }
  .bundle-info-side { flex: 1; }
  .b-image-desktop { flex: 1; }
  .b-image-desktop img, .b-image-mobile img {
    width: 100%; height: auto; display: block; border-radius: 2px;
  }
  .b-image-mobile { display: none; } /* Desktop par hide */

  .b-badge { 
     display: block;
  font-family: var(--font-paragraph--family);
font-weight: 600;
font-size: 14px;
line-height: 18px;
letter-spacing: 0px;
vertical-align: middle;
text-transform: uppercase;
color:#A47944;
padding-bottom:20px;
}
  .b-title {  
    margin: 0 0 0px 0;
font-family: var(--font-h4--family);
font-weight: 500;
font-style: Medium;
font-size: 50px;
display:block;
line-height: 100%;
letter-spacing: 0%;
color:#000;
padding-bottom:20px;

}
  .b-description { 
     margin-bottom: 30px; 
     max-width: 450px; 
  font-family: var(--font-paragraph--family);
font-weight: 400;
font-size: 18px;
line-height: 28px;
letter-spacing: 0px;
vertical-align: middle;
}
  
  .b-product-action-bar { display: flex; align-items: center; justify-content: flex-start; gap: 20px; margin-bottom: 35px; }
  .b-thumbnails { display: flex; gap: 12px; }
  .t-box { width: 70px; height: 70px; background: #f7f7f7; border: 1px solid #eee; display: flex; align-items: center; justify-content: center; padding: 5px; }
  .t-box img { max-width: 90%; height: auto; }
  
  .p-now { 

      font-family: var(--font-paragraph--family);
font-weight: 700;
font-style: Bold;
font-size: 20px;
line-height: 24px;
letter-spacing: 0px;
vertical-align: middle;
color:#000;
 }
  .p-was {
    text-decoration: line-through;
     font-family: var(--font-paragraph--family);
font-weight: 600;
font-size: 12px;
line-height: 16.8px;
letter-spacing: 1.8px;
vertical-align: middle;
text-decoration: line-through;
color:#353535;
 }
  
  .b-submit-btn {
    background: #A47944; color: #fff; border: none; padding: 18px 45px; 
    font-size: 13px; font-weight: 700; letter-spacing: 1.5px; cursor: pointer; transition: 0.3s;
  }

  /* MOBILE LAYOUT (As per your 2nd image) */
  @media (max-width: 767px) {
    .bundle-main-container { flex-direction: column; padding: 20px 15px; gap: 0; }
    .bundle-info-side { width: 100%; }
    
    .b-image-desktop { display: none; } /* Desktop image hide */
    .b-image-mobile { 
      display: block; 
      margin: 15px 0 25px 0; /* Title aur Description ke darmiyan image */
    }
    
    .b-title { font-size: 32px; margin-bottom: 15px; }
    .b-description { font-size: 14px; margin-bottom: 25px; }
    
    .b-product-action-bar { justify-content: space-between; }
    .b-submit-btn { width: 100%; }
  }
</style>
<div class="bundle-section-{{ section.id }}">
  <div class="bundle-main-container">
    
    <div class="bundle-info-side">
      <div class="bundle-head-text">
        <span class="b-badge">{{ section.settings.sub_heading }}</span>
        <h2 class="b-title">{{ section.settings.heading }}</h2>
      </div>

      <div class="b-image-mobile">
        {% if section.settings.main_image %}
          <img src="{{ section.settings.main_image | img_url: '800x' }}" alt="{{ section.settings.heading }}">
        {% endif %}
      </div>

      <div class="b-details-content">
        <p class="b-description">{{ section.settings.description }}</p>

        <div class="b-product-action-bar">
          <div class="b-thumbnails">
            {% if section.settings.thumb_1 %}
              <div class="t-box"><img src="{{ section.settings.thumb_1 | img_url: '150x' }}"></div>
            {% endif %}
            {% if section.settings.thumb_2 %}
              <div class="t-box"><img src="{{ section.settings.thumb_2 | img_url: '150x' }}"></div>
            {% endif %}
          </div>
          
          <div class="b-price-group">
            <span class="p-now">{{ section.settings.sale_price }}</span>
            <span class="p-was">{{ section.settings.regular_price }}</span>
          </div>
        </div>

        {% if section.settings.button_link != blank %}
          <a href="{{ section.settings.button_link }}" class="button b-submit-btn">
            {{ section.settings.button_text }}
          </a>
        {% else %}
          <button class="b-submit-btn">{{ section.settings.button_text }}</button>
        {% endif %}
      </div>
    </div>

    <div class="b-image-desktop">
      {% if section.settings.main_image %}
        <img src="{{ section.settings.main_image | img_url: '1000x' }}" alt="{{ section.settings.heading }}">
      {% endif %}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Responsive Jewelry Bundle",
  "settings": [
    { "type": "text", "id": "sub_heading", "label": "Sub Heading", "default": "LIMITED OFFER" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete the Set" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "The Aurelia Band pairs perfectly..." },
    { "type": "image_picker", "id": "main_image", "label": "Main Feature Image" },
    { "type": "image_picker", "id": "thumb_1", "label": "Product Thumb 1" },
    { "type": "image_picker", "id": "thumb_2", "label": "Product Thumb 2" },
    { "type": "text", "id": "sale_price", "label": "Sale Price", "default": "$1,912.50" },
    { "type": "text", "id": "regular_price", "label": "Regular Price", "default": "$2,250.00" },
    { "type": "text", "id": "button_text", "label": "Button Text", "default": "ADD BUNDLE TO BAG" },
    { "type": "url", "id": "button_link", "label": "Button Link" }
  ],
  "presets": [{ "name": "Responsive Jewelry Bundle" }]
}
{% endschema %}