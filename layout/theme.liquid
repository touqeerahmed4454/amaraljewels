<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% # theme-check-disable RemoteAsset %}
    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    {% if settings.transition_to_main_product or settings.page_transition_enabled %}
      <link
        rel="expect"
        href="#MainContent"
        blocking="render"
        id="view-transition-render-blocker"
      >
    {% endif %}

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
    {% # theme-check-enable RemoteAsset %}
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }} 
      {% if template == 'index' %} home{% endif %}
  {% if template contains 'collection' and collection %}
    collection-templete
  {% endif %}
  {% if template contains 'product' and product %}
    product-templete
  {% endif %}
  {% if template contains 'page' and page %}
    page-{{ page.handle }}
  {% endif %}
  {% if template contains 'blog' and blog %}
    blog-{{ blog.handle }}
  {% endif %}
  {% if template contains 'article' and article %}
    article-{{ article.handle }}
  {% endif %}
   ">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <script>
      // Inline header height and menu style calculations to prevent layout shift
      // Note: Updates in calculateHeaderGroupHeight(), updateTransparentHeaderOffset() and setHeaderMenuStyle() utilities.js should be kept in sync with this function
      (function setHeaderHeighCustomProperties() {
        /*
         * Header calculation functions for maintaining CSS variables
         * Mimic calculateHeaderGroupHeight() in utilities.js
         */
        const header = document.querySelector('header-component');
        const headerGroup = document.querySelector('#header-group');
        const hasHeaderSection = headerGroup?.querySelector('.header-section');

        if (!header || !headerGroup) return;

        const headerTopRow = header.querySelector('.header__row--top');
        const headerHeight = header.offsetHeight;

        // Calculate the total height of the header group
        let headerGroupHeight = 0;
        const children = headerGroup.children;
        for (let i = 0; i < children.length; i++) {
          const element = children[i];
          if (element === header || !(element instanceof HTMLElement)) continue;
          headerGroupHeight += element.offsetHeight;
        }

        // Check for transparent header special case
        if (header.hasAttribute('transparent') && header.parentElement?.nextElementSibling) {
          headerGroupHeight += headerHeight;
        }

        // Set CSS variables
        document.body.style.setProperty('--header-height', `${headerHeight}px`);
        document.body.style.setProperty('--header-group-height', `${headerGroupHeight}px`);

        if (headerTopRow) {
          window.requestAnimationFrame(function () {
            document.body.style.setProperty('--top-row-height', `${headerTopRow.offsetHeight}px`);
          });
        }

        /**
         * Updates CSS custom properties for transparent header offset calculation
         * Mimic updateTransparentHeaderOffset() in utilities.js
         */

        if (!hasHeaderSection || !header?.hasAttribute('transparent')) {
          document.body.style.setProperty('--transparent-header-offset-boolean', '0');
          return;
        }

        const hasImmediateSection = hasHeaderSection.nextElementSibling?.classList.contains('shopify-section');

        const shouldApplyOffset = !hasImmediateSection ? '1' : '0';
        document.body.style.setProperty('--transparent-header-offset-boolean', shouldApplyOffset);
      })();

      (function setHeaderMenuStyle() {
        const headerComponent = document.querySelector('#header-component');
        if (headerComponent) {
          const isTouchDevice = 'ontouchstart' in window && navigator.maxTouchPoints > 0;
          const overflowList = headerComponent?.querySelector('overflow-list');
          const hasReachedMinimum = overflowList && overflowList.hasAttribute('minimum-reached');
          headerComponent.dataset.menuStyle = isTouchDevice || hasReachedMinimum ? 'drawer' : 'menu';
        }
      })();
    </script>

    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {{ content_for_layout }}
    </main>

    <footer>
      {% sections 'footer-group' %}
    </footer>

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}
<script>
 document.addEventListener("DOMContentLoaded", function () {
  const targetMedia = document.querySelector(".product-templete .product-information__grid");
  const topHeading = document.querySelector(".product-templete .mobile-top-heading");
  const mobileQuery = window.matchMedia("(max-width: 749px)");

  if (!targetMedia) return;

  function moveElements() {
    if (mobileQuery.matches) {
      // 1. Heading ko shift karein
      if (topHeading && topHeading.previousElementSibling !== targetMedia) {
        targetMedia.parentNode.insertBefore(topHeading, targetMedia);
      }

      // 2. Review widget ko dhoondein aur shift karein
      const reviewWidget = document.querySelector(".product-templete .shopify-app-block.jdgm-horizon-widget");
      if (reviewWidget) {
        // Isko heading ke bilkul baad aur media ke uper insert karein
        targetMedia.parentNode.insertBefore(reviewWidget, targetMedia);
      }
    }
  }

  // Page load par pehli dafa run karein
  moveElements();

  // Screen resize hone par run karein
  mobileQuery.addEventListener("change", moveElements);

  // MutationObserver: Jo dynamically load hone wale review widget ko track karega
  const observer = new MutationObserver(function (mutations, obs) {
    const reviewWidget = document.querySelector(".product-templete .shopify-app-block.jdgm-horizon-widget");
    if (reviewWidget && mobileQuery.matches) {
      targetMedia.parentNode.insertBefore(reviewWidget, targetMedia);
      // Agar widget mil jaye aur shift ho jaye toh observer ko stop kar dein taake performance par asar na pare
      obs.disconnect();
    }
  });

  // Poore document par nazar rakhein ke kab widget inject hota hai
  observer.observe(document.body, {
    childList: true,
    subtree: true
  });
});
  </script>
    
<div class="size-modal" id="sizeGuideModal" aria-hidden="true">
  <div class="size-modal__content">
    <button type="button" class="size-modal__close" id="closeSizeGuide">&times;</button>
    <img src="{{ product.metafields.custom.size_guide_image | image_url: width: 800 }}" alt="Size Guide" class="size-modal__img" loading="lazy">
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const modal = document.getElementById("sizeGuideModal");
    const openBtn = document.getElementById("openSizeGuide");
    const closeBtn = document.getElementById("closeSizeGuide");

    if (openBtn && modal) {
      openBtn.addEventListener("click", function (e) {
        e.preventDefault();
        modal.classList.add("is-open");
        document.body.style.overflow = "hidden"; // Background scroll lock
      });

      closeBtn.addEventListener("click", function () {
        modal.classList.remove("is-open");
        document.body.style.overflow = ""; // Scroll unlock
      });

      // Agar modal ke baahir click ho toh band ho jaye
      modal.addEventListener("click", function (e) {
        if (e.target === modal) {
          modal.classList.remove("is-open");
          document.body.style.overflow = "";
        }
      });
    }
  });
</script>
<style>
  /* Button Styling - Image se 100% match */
  .size-guide-trigger-wrapper {
    margin: 15px 0;
    display: inline-block;
  }
  .size-guide-trigger {
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: #121212;
    cursor: pointer;
    font-family: inherit;
  }
  .size-guide-trigger span {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .size-guide-trigger svg {
    width: 16px;
    height: 16px;
    color: #444;
  }

  /* Popup/Modal Layout */
  .size-modal {
    display: none; 
    position: fixed;
    z-index: 99999;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .size-modal.is-open {
    display: flex;
    opacity: 1;
  }
  .size-modal__content {
    background-color: #fff;
    padding: 30px;
    border-radius: 4px;
    max-width: 600px;
    width: 90%;
    position: relative;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
    animation: slideUp 0.3s ease;
  }
  .size-modal__close {
    position: absolute;
    top: 12px;
    right: 15px;
    font-size: 24px;
    background: none;
    border: none;
    cursor: pointer;
    color: #000;
    line-height: 1;
  }
  .size-modal__img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }
  .size-chart-cont{
    width: 100%;
    height: 0px;
    margin: 0px;
    padding: 0px;
    margin-top: -30px;
    display: block;
    position: relative;
  }
    .size-chart-cont .size-guide-trigger-wrapper{
    position: absolute;
  right: 0;
  top:45px;
}
  @keyframes slideUp {
    from { transform: translateY(20px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }
</style>

  </body>
</html>
